[
    {
        "name": "Imgur",
        "url_match": "imgur\\.com/(gallery|a)/",
        "media_patterns": [
            "<meta[^>]+property=\"og:image\"[^>]+content=\"([^\"]+)\"",
            "<meta[^>]+name=\"twitter:image\"[^>]+content=\"([^\"]+)\"",
            "<img[^>]+src=\"([^\"]+\\.(jpg|jpeg|png|gif|gifv|mp4|webm|webp))\""
        ]
    },
    {
        "name": "Reddit media",
        "url_match": "(i\\.redd\\.it|preview\\.redd\\.it|v\\.redd\\.it)",
        "media_patterns": [
            "(https?://[^\"'\\s]+\\.(jpg|jpeg|png|gif|mp4|webm|webp))"
        ]
    }
]
